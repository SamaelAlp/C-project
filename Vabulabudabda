#include <iostream>
#include <vector>
#include <set>
#include <algorithm>
#include <random>
#include <functional>
#include <numeric>

// Неизменяемые типы
enum class cell_type { wall, room, corridor };

struct room {
    const int x, y, width, height;
    room(int x, int y, int w, int h) : x(x), y(y), width(w), height(h) {}

    struct point { const int x, y; };
    point center() const { return {x + width / 2, y + height / 2}; }
};

using map_type = std::vector<std::vector<cell_type>>;

// Проверка пересечения комнат
bool intersects(const room& a, const room& b) {
    return a.x < b.x + b.width &&
           a.x + a.width > b.x &&
           a.y < b.y + b.height &&
           a.y + a.height > b.y;
}

// Генерация случайной комнаты
room generate_random_room(int map_width, int map_height, std::mt19937& rng) {
    std::uniform_int_distribution<int> width_dist(3, 10), height_dist(3, 10);
    int w = width_dist(rng), h = height_dist(rng);
    std::uniform_int_distribution<int> x_dist(1, map_width - w - 1);
    std::uniform_int_distribution<int> y_dist(1, map_height - h - 1);
    int x = x_dist(rng), y = y_dist(rng);
    return room(x, y, w, h);
}

// Рекурсивная генерация непересекающихся комнат
std::vector<room> generate_rooms_helper(
    int n,
    int width,
    int height,
    std::vector<room> rooms,
    std::mt19937& rng
) {
    if (n <= 0) return rooms;

    room r = generate_random_room(width, height, rng);
    const bool has_intersect = std::any_of(rooms.cbegin(), rooms.cend(),
        [&r](const room& other) { return intersects(r, other); });

    if (has_intersect) {
        return generate_rooms_helper(n, width, height, std::move(rooms), rng);
    } else {
        std::vector<room> new_rooms = rooms;
        new_rooms.push_back(r);
        return generate_rooms_helper(n - 1, width, height, std::move(new_rooms), rng);
    }
}

// Создание карты с комнатами
map_type create_map(int width, int height, const std::vector<room>& rooms) {
    map_type map(height, std::vector<cell_type>(width, cell_type::wall));

    auto fill_room = [&](const room& r) {
        for (int dy = 0; dy < r.height; ++dy) {
            for (int dx = 0; dx < r.width; ++dx) {
                map[r.y + dy][r.x + dx] = cell_type::room;
            }
        }
    };
    std::for_each(rooms.cbegin(), rooms.cend(), fill_room);
    return map;
}

// Структура ребра графа
struct edge {
    const int u, v, weight;
    edge(int u, int v, int w) : u(u), v(v), weight(w) {};
};

// Генерация всех возможных рёбер между центрами комнат
std::vector<edge> generate_edges(const std::vector<room::point>& centers) {
    std::vector<edge> edges;
    for (size_t i = 0; i < centers.size(); ++i) {
        for (size_t j = i + 1; j < centers.size(); ++j) {
            int dx = centers[i].x - centers[j].x;
            int dy = centers[i].y - centers[j].y;
            edges.emplace_back(static_cast<int>(i), static_cast<int>(j), dx * dx + dy * dy);
        }
    }
    return edges;
}

// Инициализация компонент связности (каждая комната — отдельная компонента)
std::vector<std::set<int>> initial_components(size_t n) {
    std::vector<std::set<int>> comp;
    comp.reserve(n);
    for (size_t i = 0; i < n; ++i) {
        comp.push_back({static_cast<int>(i)});
    }
    return comp;
}

// Рекурсивная реализация алгоритма Краскала
std::vector<edge> kruskal_helper(
    std::vector<edge> edges,
    std::vector<std::set<int>> comps,
    std::vector<edge> mst
) {
    if (edges.empty()) return mst;

    edge e = edges[0];
    std::vector<edge> rest(edges.cbegin() + 1, edges.cend());

    auto find_set = [&e](const std::vector<std::set<int>>& c, int v) {
        return std::find_if(c.cbegin(), c.cend(),
            [v](const std::set<int>& s) { return s.count(v) > 0; });
    };

    auto comp_u = find_set(comps, e.u);
    auto comp_v = find_set(comps, e.v);

    if (comp_u != comps.cend() && comp_v != comps.cend() && comp_u != comp_v) {
        std::set<int> merged = *comp_u;
        merged.insert(comp_v->cbegin(), comp_v->cend());

        std::vector<std::set<int>> new_comps;
        std::for_each(comps.cbegin(), comps.cend(), [&](const std::set<int>& s) {
            if (&s != &*comp_u && &s != &*comp_v) {
                new_comps.push_back(s);
            }
        });
        new_comps.push_back(std::move(merged));

        std::vector<edge> new_mst = mst;
        new_mst.push_back(e);
        return kruskal_helper(std::move(rest), std::move(new_comps), std::move(new_mst));
    }

    return kruskal_helper(std::move(rest), std::move(comps), std::move(mst));
}

// Рекурсивное рисование коридоров
map_type draw_vertical(const map_type& map, const std::vector<room>& rooms, int x, int y, int target_x, int target_y);

map_type draw_horizontal(const map_type& map, const std::vector<room>& rooms, int x, int y, int target_x, int target_y) {
    if (x == target_x) {
        return draw_vertical(map, rooms, x, y, target_x, target_y);
    }

    int next_x = (target_x > x) ? x + 1 : x - 1;
    bool in_room = std::any_of(rooms.cbegin(), rooms.cend(),
        [x, y](const room& r) {
            return x >= r.x && x < r.x + r.width &&
                   y >= r.y && y < r.y + r.height;
        });

    map_type new_map = map;
    if (!in_room) {
        new_map[y][x] = cell_type::corridor;
    }
    return draw_horizontal(new_map, rooms, next_x, y, target_x, target_y);
}

map_type draw_vertical(const map_type& map, const std::vector<room>& rooms, int x, int y, int target_x, int target_y) {
    if (y == target_y) return map;

    int next_y = (target_y > y) ? y + 1 : y - 1;
    bool in_room = std::any_of(rooms.cbegin(), rooms.cend(),
        [x, y](const room& r) {
            return x >= r.x && x < r.x + r.width &&
                   y >= r.y && y < r.y + r.height;
        });

    map_type new_map = map;
    if (!in_room) {
        new_map[y][x] = cell_type::corridor;
    }
    return draw_horizontal(new_map, rooms, x, next_y, target_x, target_y);
}

// Рекурсивное добавление всех коридоров по MST
map_type add_corridors(const map_type& map, const std::vector<room>& rooms, const std::vector<edge>& mst) {
    if (mst.empty()) return map;

    const edge& e = mst[0];
    room::point start = rooms[e.u].center();
    room::point end = rooms[e.v].center();

    map_type updated_map = draw_horizontal(map, rooms, start.x, start.y, end.x, end.y);
    std::vector<edge> remaining_edges(mst.cbegin() + 1, mst.cend());

    return add_corridors(updated_map, rooms, remaining_edges);
}

// Рендеринг карты в строку
std::string render_map(const map_type& map) {
    return std::accumulate(map.cbegin(), map.cend(), std::string{},
        [](const std::string& acc, const std::vector<cell_type>& row) {
            std::string line = std::accumulate(row.cbegin(), row.cend(), std::string{},
                [](const std::string& l, cell_type c) {
                    return l + ((c == cell_type::wall) ? '#' : '.');
                });
            return acc + line + '\n';
        });
}

// Точка входа
int main() {
    std::mt19937 rng(std::random_device{}());

    const int map_width = 80;
    const int map_height = 25;
    const int num_rooms = 5;

    auto rooms = generate_rooms_helper(num_rooms, map_width, map_height, {}, rng);
    auto map = create_map(map_width, map_height, rooms);

    std::vector<room::point> centers;
    std::transform(rooms.cbegin(), rooms.cend(), std::back_inserter(centers),
        [](const room& r) { return r.center(); });

    auto edges = generate_edges(centers);
    std::sort(edges.begin(), edges.end(),
        [](const edge& a, const edge& b) { return a.weight < b.weight; });

    auto components = initial_components(centers.size());
    auto mst = kruskal_helper(edges, components, {});

    auto final_map = add_corridors(map, rooms, mst);
    std::cout << render_map(final_map);

    return 0;
}
